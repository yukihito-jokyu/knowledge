{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "search-relatedの入出力",
  "description": "指定主張と保存済み関係で結ばれた候補を取得するJSON。関係の妥当性を新たに推論しない。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id"
      ],
      "properties": {
        "assertion_id": {
          "$ref": "cli-contract.schema.json#/$defs/identifier",
          "description": "関係探索の起点となる既存主張。"
        },
        "relation_kinds": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "$ref": "cli-contract.schema.json#/$defs/nonEmptyText"
          },
          "description": "対象にする関係種別。省略時は全種別。"
        },
        "direction": {
          "enum": [
            "outgoing",
            "incoming",
            "both"
          ],
          "default": "both",
          "description": "探索する保存済み関係の向き。outgoingは起点主張から候補へ出る関係、incomingは候補から起点へ入る関係、bothは両方である。個々の結果の向きを表す値、未登録の関係、任意の文字列は許可しない。"
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "continuation_token": {
          "$ref": "cli-contract.schema.json#/$defs/nonEmptyText"
        }
      }
    },
    "success": {
      "allOf": [
        {
          "$ref": "cli-contract.schema.json#/$defs/success"
        },
        {
          "properties": {
            "result": {
              "$ref": "cli-contract.schema.json#/$defs/relatedCollection"
            }
          }
        }
      ]
    },
    "error": {
      "$ref": "cli-contract.schema.json#/$defs/errorResponse"
    }
  },
  "oneOf": [
    {
      "required": [
        "request"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "success"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "success"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "success"
            ]
          }
        ]
      }
    }
  ]
}
