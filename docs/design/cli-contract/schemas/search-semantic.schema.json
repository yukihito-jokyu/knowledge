{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "search-semanticの入出力",
  "description": "入力文と意味的に近い主張候補を取得するJSON。近さは検索の手掛かりであり真偽判定ではない。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": {
      "allOf": [
        {
          "$ref": "cli-contract.schema.json#/$defs/searchPageRequest"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statement"
          ],
          "properties": {
            "statement": {
              "$ref": "cli-contract.schema.json#/$defs/nonEmptyText",
              "description": "意味的な近さを調べる空でない入力文。"
            },
            "scope": {
              "$ref": "cli-contract.schema.json#/$defs/scope"
            },
            "page_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "top_k": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "continuation_token": {
              "$ref": "cli-contract.schema.json#/$defs/nonEmptyText"
            }
          }
        }
      ]
    },
    "success": {
      "allOf": [
        {
          "$ref": "cli-contract.schema.json#/$defs/success"
        },
        {
          "properties": {
            "result": {
              "$ref": "cli-contract.schema.json#/$defs/searchCollection"
            }
          }
        }
      ]
    },
    "error": {
      "$ref": "cli-contract.schema.json#/$defs/errorResponse"
    }
  },
  "oneOf": [
    {
      "required": [
        "request"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "success"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "success"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "success"
            ]
          }
        ]
      }
    }
  ]
}
