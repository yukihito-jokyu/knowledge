{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "supersedeの入出力",
  "description": "旧主張を新主張で置換し、対応する後継関係を残すJSON。多対多の置換でも根拠と来歴を失わないために必要である。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": {
      "allOf": [
        {
          "$ref": "cli-contract.schema.json#/$defs/updateCommon"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id",
            "decided_by",
            "decision_rationale",
            "expected_revisions",
            "affected_assertion_ids",
            "old_assertion_ids",
            "new_assertions",
            "supersedes_links"
          ],
          "properties": {
            "operation_id": {
              "$ref": "cli-contract.schema.json#/$defs/operationId"
            },
            "decided_by": {
              "$ref": "cli-contract.schema.json#/$defs/actor"
            },
            "decision_rationale": {
              "$ref": "cli-contract.schema.json#/$defs/nonEmptyText"
            },
            "expected_revisions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "cli-contract.schema.json#/$defs/expectedRevision"
              }
            },
            "affected_assertion_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "cli-contract.schema.json#/$defs/identifier"
              }
            },
            "old_assertion_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "cli-contract.schema.json#/$defs/identifier"
              },
              "description": "置換する一件以上の既存主張。"
            },
            "new_assertions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "cli-contract.schema.json#/$defs/newAssertionInput"
              },
              "description": "新しい主張と各主張を支える根拠。新規IDは指定しない。"
            },
            "supersedes_links": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "cli-contract.schema.json#/$defs/supersedesLinkInput"
              },
              "description": "新旧主張を結ぶ一件以上の後継関係。"
            }
          }
        }
      ]
    },
    "success": {
      "allOf": [
        {
          "$ref": "cli-contract.schema.json#/$defs/success"
        },
        {
          "properties": {
            "result": {
              "$ref": "cli-contract.schema.json#/$defs/operationResult"
            }
          }
        }
      ]
    },
    "error": {
      "$ref": "cli-contract.schema.json#/$defs/errorResponse"
    }
  },
  "oneOf": [
    {
      "required": [
        "request"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "success"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "success"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "success"
            ]
          }
        ]
      }
    }
  ]
}
