{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get-evidenceの入出力",
  "description": "主張に結び付く根拠、又は指定根拠の版を取得するJSON。根拠不在は主張が偽である結論ではない。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id"
      ],
      "properties": {
        "assertion_id": {
          "$ref": "cli-contract.schema.json#/$defs/identifier",
          "description": "根拠を求める既存主張。"
        },
        "evidence_id": {
          "$ref": "cli-contract.schema.json#/$defs/identifier",
          "description": "指定時だけ一件の既存根拠へ絞り込む。"
        },
        "revision_id": {
          "$ref": "cli-contract.schema.json#/$defs/identifier",
          "description": "evidence_id指定時だけ許可する根拠の保存済み改訂版。"
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "continuation_token": {
          "$ref": "cli-contract.schema.json#/$defs/nonEmptyText"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "revision_id"
            ]
          },
          "then": {
            "required": [
              "evidence_id"
            ]
          }
        },
        {
          "if": {
            "required": [
              "evidence_id"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "page_size"
                  ]
                },
                {
                  "required": [
                    "continuation_token"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "success": {
      "allOf": [
        {
          "$ref": "cli-contract.schema.json#/$defs/success"
        },
        {
          "properties": {
            "result": {
              "$ref": "cli-contract.schema.json#/$defs/evidenceResult"
            }
          }
        }
      ]
    },
    "error": {
      "$ref": "cli-contract.schema.json#/$defs/errorResponse"
    }
  },
  "oneOf": [
    {
      "required": [
        "request"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "success"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "success"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "success"
            ]
          }
        ]
      }
    }
  ]
}
