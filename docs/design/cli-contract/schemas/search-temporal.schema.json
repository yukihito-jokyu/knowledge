{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "search-temporalの入出力",
  "description": "指定主張と時点又は製品版が異なる候補を取得するJSON。新旧・正誤をCLIが確定しない。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id"
      ],
      "properties": {
        "assertion_id": {
          "$ref": "cli-contract.schema.json#/$defs/identifier",
          "description": "比較の基準となる既存主張。"
        },
        "as_of": {
          "$ref": "cli-contract.schema.json#/$defs/isoDateTime",
          "description": "比較する時点。省略時は基準主張の時点。"
        },
        "product_version": {
          "$ref": "cli-contract.schema.json#/$defs/nonEmptyText",
          "description": "比較する製品版。省略時は基準主張の製品版。"
        },
        "scope": {
          "$ref": "cli-contract.schema.json#/$defs/scope"
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "continuation_token": {
          "$ref": "cli-contract.schema.json#/$defs/nonEmptyText"
        }
      }
    },
    "success": {
      "allOf": [
        {
          "$ref": "cli-contract.schema.json#/$defs/success"
        },
        {
          "properties": {
            "result": {
              "$ref": "cli-contract.schema.json#/$defs/searchCollection"
            }
          }
        }
      ]
    },
    "error": {
      "$ref": "cli-contract.schema.json#/$defs/errorResponse"
    }
  },
  "oneOf": [
    {
      "required": [
        "request"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "success"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "success"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "success"
            ]
          }
        ]
      }
    }
  ]
}
