{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "createの入出力",
  "description": "新しい主張を少なくとも一件の根拠とともに原子的に保存するJSON。CLIが根拠なしの確定知識を作らないために必要である。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": {
      "allOf": [
        {
          "$ref": "cli-contract.schema.json#/$defs/updateCommon"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id",
            "decided_by",
            "decision_rationale",
            "expected_revisions",
            "affected_assertion_ids",
            "assertion",
            "evidence"
          ],
          "properties": {
            "operation_id": {
              "$ref": "cli-contract.schema.json#/$defs/operationId"
            },
            "decided_by": {
              "$ref": "cli-contract.schema.json#/$defs/actor"
            },
            "decision_rationale": {
              "$ref": "cli-contract.schema.json#/$defs/nonEmptyText"
            },
            "expected_revisions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "cli-contract.schema.json#/$defs/expectedRevision"
              }
            },
            "affected_assertion_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "cli-contract.schema.json#/$defs/identifier"
              }
            },
            "assertion": {
              "$ref": "cli-contract.schema.json#/$defs/assertionInput",
              "description": "保存する新しい主張内容。新規ID・初版IDはCLIが割り当てるため指定禁止。"
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "cli-contract.schema.json#/$defs/evidenceInput"
              },
              "description": "主張を支える一件以上の根拠。空配列を禁止する。"
            },
            "relations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "cli-contract.schema.json#/$defs/relationInput"
              },
              "description": "新主張と既存主張を結ぶ関係。関連がない場合だけ省略又は空配列。"
            }
          }
        }
      ]
    },
    "success": {
      "allOf": [
        {
          "$ref": "cli-contract.schema.json#/$defs/success"
        },
        {
          "properties": {
            "result": {
              "$ref": "cli-contract.schema.json#/$defs/operationResult"
            }
          }
        }
      ]
    },
    "error": {
      "$ref": "cli-contract.schema.json#/$defs/errorResponse"
    }
  },
  "oneOf": [
    {
      "required": [
        "request"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "success"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "success"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "success"
            ]
          }
        ]
      }
    }
  ]
}
